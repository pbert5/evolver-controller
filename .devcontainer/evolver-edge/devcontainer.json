{
  "name": "Meta Ball eVOLVER Edge",
  "build": {"dockerfile": "Dockerfile", "context": "."},
  "remoteUser": "vscode",
  "containerName": "meta-ball-${localEnv:META_BALL_WORKTREE_ID}-evolver-edge",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/meta_bal,type=bind",
  "workspaceFolder": "/workspaces/meta_bal",
  "features": {"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}},
  "runArgs": ["--group-add=0"],
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-python.debugpy", "openai.chatgpt", "ms-azuretools.vscode-containers", "ms-azuretools.vscode-docker", "jackiotyu.git-worktree-manager"], "settings": {"terminal.integrated.defaultProfile.linux": "zsh", "terminal.integrated.profiles.linux": {"zsh": {"path": "/usr/bin/zsh"}}}}},
  "containerEnv": {"META_BALL_WORKTREE_ID": "${localEnv:META_BALL_WORKTREE_ID}", "EVOLVER_OPERATOR_SOCKET": "/run/evolver-controller/operator.sock"},
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind", "source=meta-ball-${localEnv:META_BALL_WORKTREE_ID}-edge-uv-cache-v2,target=/home/vscode/.cache/uv,type=volume", "source=evolver-edge-runtime,target=/run/evolver-controller,type=volume"],
  "postCreateCommand": "bootstrap-evolver-edge"
}
