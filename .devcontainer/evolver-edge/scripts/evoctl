#!/usr/bin/env bash
set -Eeuo pipefail
socket_path="${EVOLVER_OPERATOR_SOCKET:-/run/evolver-controller/operator.sock}"

# Normal commands are live-only.  This preflight prevents the controller CLI
# from interpreting a missing operator service as permission to read SQLite.
case " $* " in
  *" --offline "*|" rescue "*|" --help "*) ;;
  *)
    if ! python - "$socket_path" <<'PY'
import socket
import sys

path = sys.argv[1]
try:
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(1.0)
        sock.connect(path)
except (OSError, ValueError):
    raise SystemExit(1)
PY
    then
      cat >&2 <<'EOF'
eVOLVER controller operator service is unavailable or unreachable.
  If the controller is stopped: tools/evolver-edge up
  If it is running but unreachable:
    tools/evolver-edge status
    tools/evolver-edge logs controller
  For intentional local recovery, use: evoctl rescue recovery
  Rescue is explicit and offline; it does not report live controller state.
EOF
      exit 69
    fi
    ;;
esac

if [[ "${1:-}" == rescue ]]; then
  shift
  [[ "$#" -gt 0 ]] || set -- recovery
  exec uv run --project /workspaces/meta_bal/evolver/evolver-controller evoctl --offline "$@"
fi

exec uv run --project /workspaces/meta_bal/evolver/evolver-controller evoctl "$@"
