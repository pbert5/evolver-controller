#!/usr/bin/env bash
set -Eeuo pipefail

rtk --version
rtk gain >/dev/null

prepare-dev-volumes

uv_status=0
uv sync --all-packages --all-extras &
uv_pid=$!

cleanup() {
  local status=$?
  if kill -0 "$uv_pid" 2>/dev/null; then kill "$uv_pid" 2>/dev/null || true; fi
  wait "$uv_pid" 2>/dev/null || true
  return "$status"
}
trap cleanup EXIT INT TERM

if wait "$uv_pid"; then
  :
else
  uv_status=$?
  printf 'bootstrap-devcontainer: uv sync failed (status %s)\n' "$uv_status" >&2
fi
if (( uv_status != 0 )); then
  printf 'bootstrap-devcontainer: failed (uv=%s)\n' "$uv_status" >&2
  exit 1
fi
