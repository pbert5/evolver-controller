#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_DIR=$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)
readonly ROOT_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
readonly COMPOSE_FILE="$ROOT_DIR/deploy/postgres-acceptance/compose.yaml"
readonly PROJECT="meta-ball-postgres-acceptance-${META_BALL_WORKTREE_ID:-$$}"
readonly COMPOSE=(docker compose -f "$COMPOSE_FILE" -p "$PROJECT")

cleanup() {
  "${COMPOSE[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

"${COMPOSE[@]}" up --detach --wait postgres
container_id=$("${COMPOSE[@]}" ps -q postgres)
host_gateway=$(docker inspect --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$container_id")
[[ -n "$host_gateway" ]] || { echo 'test-postgres-acceptance: PostgreSQL container address was not found' >&2; exit 1; }

export META_WEBUI_INTERFACE_DATABASE_URL="postgresql://meta_webui_acceptance:meta_webui_acceptance@${host_gateway}:5432/meta_webui_acceptance"
export META_WEBUI_BUILD_REVISION="postgres-acceptance"
export PYTHONPATH="$ROOT_DIR:$ROOT_DIR/evolver/evolver-server/src${PYTHONPATH:+:$PYTHONPATH}"

uv run --project "$ROOT_DIR/evolver/evolver-server" pytest -q \
  "$ROOT_DIR/integration/tests/test_postgres_acceptance.py"
