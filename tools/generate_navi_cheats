#!/usr/bin/env python3
"""Build the checked-in Navi catalog from repository-owned cheat sources."""

from __future__ import annotations

import argparse
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
SOURCE_DIR = ROOT / "docs" / "navi" / "cheatsheets"
OUTPUT = ROOT / "docs" / "navi" / "generated" / "meta-ball.cheat"
HEADER = """# GENERATED FILE. DO NOT EDIT.\n# Run tools/generate-navi-cheats after changing docs/navi/cheatsheets/.\n"""


def action_entries() -> str:
    """Render one searchable entry for every deployment catalog action."""
    index_path = ROOT / "metactl" / "applications" / "deployment" / "action-catalog.json"
    if not index_path.is_file():
        return ""
    index = json.loads(index_path.read_text(encoding="utf-8"))
    entries: list[str] = []
    for reference in index["catalogs"]:
        catalog = json.loads((index_path.parent / reference["path"]).read_text(encoding="utf-8"))
        for action in catalog["actions"]:
            action_id = action["id"]
            tags = " ".join(action.get("tags", []))
            safety = action.get("safety", {})
            effect = safety.get("effect") or ("mutation" if "mutat" in tags else "read-only")
            warning = " mutation confirmation-required" if effect != "read-only" else ""
            args = "".join(f" --{name.replace('_', '-')} <{name}>" for name, spec in action.get("parameters", {}).items()
                           if spec.get("required"))
            entries.append("\n".join([
                f"% Meta BAL action {action_id} {action.get('title', '')} {tags} {effect}{warning}",
                f"metactl {action_id}{args}",
            ]))
    return "\n\n".join(entries)


def render() -> str:
    sources = sorted(SOURCE_DIR.glob("*.cheat"), key=lambda path: path.relative_to(ROOT).as_posix())
    if not sources:
        raise SystemExit(f"no Navi source files found in {SOURCE_DIR}")

    sections: list[str] = []
    for source in sources:
        text = source.read_text(encoding="utf-8").replace("\r\n", "\n").replace("\r", "\n").rstrip()
        if not text:
            raise SystemExit(f"Navi source is empty: {source}")
        sections.append(text)
    generated_actions = action_entries()
    if generated_actions:
        sections.append("% Generated metactl action catalog\n" + generated_actions)
    return HEADER + "\n\n".join(sections) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="fail when the checked-in catalog is stale")
    args = parser.parse_args()
    expected = render()

    if args.check:
        actual = OUTPUT.read_text(encoding="utf-8") if OUTPUT.exists() else None
        if actual != expected:
            print(f"stale Navi catalog: {OUTPUT}")
            print("run tools/generate-navi-cheats")
            return 1
        return 0

    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(expected, encoding="utf-8", newline="\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
