#!/usr/bin/env bash
set -Eeuo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
profile=server
action=''
declare -a action_args=()
# Canonical: tools/dev-env [profile] action [args...]. Accept action-first
# spelling for compatibility with older checkouts and scripts.
if [[ "${1:-}" == server || "${1:-}" == common || "${1:-}" == evolver-edge ]]; then
  profile=$1; shift
  if [[ "$profile" == common ]]; then echo 'tools/dev-env: common is deprecated; use server' >&2; profile=server; fi
  action=${1:-}; shift || true
else
  action=${1:-}; shift || true
  if [[ "${1:-}" == server || "${1:-}" == common || "${1:-}" == evolver-edge ]]; then
    profile=$1; shift
    if [[ "$profile" == common ]]; then echo 'tools/dev-env: common is deprecated; use server' >&2; profile=server; fi
  fi
fi
action_args=("$@")
if [[ -n "${META_BALL_WORKTREE_ID:-}" ]]; then
  id=$META_BALL_WORKTREE_ID
else
  branch=$(git -C "$ROOT" branch --show-current 2>/dev/null || true)
  slug=$(printf '%s' "${branch:-worktree}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g;s/--*/-/g;s/^-//;s/-$//')
  path=$(cd "$ROOT" && pwd -P)
  if command -v sha256sum >/dev/null; then hash=$(printf '%s' "$path" | sha256sum | cut -c1-10); else hash=$(printf '%s' "$path" | shasum -a 256 | cut -c1-10); fi
  id="${slug:-worktree}-${hash}"
fi
name="meta-ball-${id}-${profile}"
config="$ROOT/.devcontainer/${profile}/devcontainer.json"
cd "$ROOT"
usage() { echo 'usage: tools/dev-env [server|evolver-edge] {identity|check|status|network|smoke|up|shell|exec <command...>|rebuild|down|build}'; }
container_id() { docker ps -aq --filter "label=devcontainer.local_folder=$ROOT" --filter "label=devcontainer.config_file=$config" | head -1; }
state() { local id; id=$(container_id); [[ -n "$id" ]] && docker inspect --format '{{.State.Status}}' "$id" || echo absent; }
case "$action" in
  identity) printf '%s\n' "$id" ;;
  check) command -v jq >/dev/null || { echo 'check requires jq' >&2; exit 2; }; jq empty "$config"; if [[ "$profile" == server ]]; then rg -q 'Meta Ball Server' "$config"; jq -e '.containerEnv.META_WEBUI_METACTL_CENTRAL_URL == "http://127.0.0.1:18087"' "$config" >/dev/null; else rg -q 'Meta Ball eVOLVER Edge' "$config"; fi; if rg -Pq '(?i:[A-Za-z0-9_]+META_WEBUI_METACTL_CENTRAL_URL)|(?i:META_WEBUI_)(?!METACTL_CENTRAL_URL(?![A-Za-z0-9_]))' "$config" "$ROOT/.devcontainer/Dockerfile" .vscode || rg -qi 'meta-webui|npm-cache|PLAYWRIGHT|Chromium' "$config" "$ROOT/.devcontainer/Dockerfile" .vscode; then exit 1; fi; test ! -e .env.local; echo "configuration valid: $id" ;;
  status) echo "worktree: $ROOT"; echo "identity: $id"; echo "container: $name"; echo "state: $(state)"; command -v devcontainer >/dev/null && devcontainer --version || echo 'devcontainer: unavailable'; [[ -S /var/run/docker.sock ]] && echo 'host Docker socket: available' || echo 'host Docker socket: unavailable' ;;
  network) echo "bind address: ${META_BAL_DEV_BIND_ADDRESS:-127.0.0.1}"; echo "port: ${META_BAL_DEV_PORT:-18086}"; if command -v tailscale >/dev/null; then tailscale ip -4 | sed 's#^#Tailscale IPv4: #' || true; fi; hostname -I 2>/dev/null | tr ' ' '\n' | awk -F. 'NF == 4 {print "LAN candidate: " $0}'; echo "Controller URL (when explicitly bound): http://${META_BAL_DEV_BIND_ADDRESS:-127.0.0.1}:${META_BAL_DEV_PORT:-18086}" ;;
  build) export META_BALL_WORKTREE_ID="$id"; devcontainer build --workspace-folder "$ROOT" --config "$config" ;;
  smoke) export META_BALL_WORKTREE_ID="$id"; if [[ "$profile" == server ]]; then smoke='command -v rtk uv python pytest navi codex docker >/dev/null; uv run --project /workspaces/meta_bal python -c "import yaml"; uv run --project /workspaces/meta_bal/evolver/evolver-controller evoctl --help >/dev/null; uv run --project /workspaces/meta_bal/metactl metactl --help >/dev/null; navi --version >/dev/null; codex --version >/dev/null; docker --version >/dev/null'; else smoke='command -v rtk uv python navi codex docker >/dev/null; uv run --project /workspaces/meta_bal/evolver/evolver-controller evoctl --help >/dev/null; test -d /run/evolver-controller'; fi; devcontainer exec --workspace-folder "$ROOT" --config "$config" bash -lc "set -euo pipefail; $smoke; echo \"$profile smoke checks passed\"" ;;
  up|rebuild) export META_BALL_WORKTREE_ID="$id"; if [[ "$action" == rebuild ]]; then old=$(container_id); [[ -z "$old" ]] || docker rm -f "$old" >/dev/null; fi; devcontainer up --workspace-folder "$ROOT" --config "$config" ;;
  shell) export META_BALL_WORKTREE_ID="$id"; devcontainer exec --workspace-folder "$ROOT" --config "$config" zsh -l -i ;;
  exec) [[ ${#action_args[@]} -gt 0 ]] || { usage; exit 2; }; export META_BALL_WORKTREE_ID="$id"; devcontainer exec --workspace-folder "$ROOT" --config "$config" "${action_args[@]}" ;;
  down) old=$(container_id); [[ -z "$old" ]] || docker rm -f "$old" ;;
  *) usage; exit 2;;
esac
